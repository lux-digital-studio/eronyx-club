Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env|\.env\..*|composer\.json|composer\.lock)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|database|storage|routes|vendor|tests)(/|$) - [F,L]
</IfModule>
