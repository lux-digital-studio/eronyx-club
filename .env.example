APP_NAME=ERONYX
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/eronyx/public

# Production:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eronyx
# Local XAMPP default. Production: dedicated app user, never root.
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=eronyx_session
# Production HTTPS cookies are forced Secure by the app.
SECURE_COOKIES=false
COOKIE_SAMESITE=Lax
# Comma-separated proxy IPs only. Empty = ignore X-Forwarded-* headers.
TRUSTED_PROXIES=

# 32-byte MFA key as 64 hex chars or standard base64.
# Generate once, back up offline, do not rotate casually (breaks existing TOTP secrets).
# Example generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MFA_ENCRYPTION_KEY=

# local/test may use array. production/staging must use smtp.
MAIL_MAILER=array
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ERONYX
MAIL_TIMEOUT=10

# manual_review | self_declaration | provider
# provider=test is forbidden in production/staging.
VERIFICATION_MODE=manual_review
VERIFICATION_PROVIDER=
VERIFICATION_SESSION_TTL=86400
VERIFICATION_REQUIRE_FOR_CREATOR=true

LEGAL_TERMS_VERSION=2026-08-22
LEGAL_PRIVACY_VERSION=2026-08-22
LEGAL_COOKIES_VERSION=2026-08-22
LEGAL_CONTENT_POLICY_VERSION=2026-08-22
LEGAL_CREATOR_RULES_VERSION=2026-08-22
LEGAL_AGE_POLICY_VERSION=2026-08-22
LEGAL_REPORTING_POLICY_VERSION=2026-08-22
LEGAL_BUSINESS_NAME=
LEGAL_EMAIL=
PRIVACY_EMAIL=
LEGAL_JURISDICTION=
